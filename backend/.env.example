# AniNexus owns and writes this database.
DATABASE_URL=mysql+pymysql://aninexus:change-me@127.0.0.1:3306/aninexus?charset=utf8mb4

# Optional legacy search_manga catalog. The import command only reads this database.
LEGACY_DATABASE_URL=mysql+pymysql://aninexus_import:change-me@127.0.0.1:3306/anime_explorer?charset=utf8mb4

# Importer defaults. CLI arguments override these values.
IMPORT_BATCH_SIZE=1000

# Optional default bundle path for the one-command public-data importer.
PUBLIC_CATALOG_PATH=backend/data/aninexus-public-catalog.jsonl.gz

# Local development defaults. Authentication will replace this development identity later.
DEFAULT_USER_ID=1
AUTO_CREATE_TABLES=true
